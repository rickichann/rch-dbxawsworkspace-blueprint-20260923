# Normalise line endings in the repo to LF regardless of the OS committing.
* text=auto eol=lf

# Shell scripts must stay LF, CRLF breaks the shebang under bash.
*.sh text eol=lf

# Terraform tooling is LF-native.
*.tf      text eol=lf
*.tfvars  text eol=lf
*.hcl     text eol=lf
*.md      text eol=lf

# Never touch these
*.png binary
*.jpg binary
*.pdf binary
