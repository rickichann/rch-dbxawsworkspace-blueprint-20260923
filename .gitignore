# ─── Terraform ─────────────────────────────────────────────────────────────────

# State files (contain sensitive resource details)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup

# Terraform working directory (cached providers, modules)
.terraform/

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. It pins provider
# versions and checksums so every engineer and every CI run resolves the same
# providers. Commit it. Run `terraform providers lock` to add other platforms.

# Plan files
*.tfplan

# Crash logs
crash.log
crash.*.log

# ─── Sensitive files ──────────────────────────────────────────────────────────

# Deployment-specific variable values: credentials, resource IDs, workspace URLs.
# Terraform loads *.auto.tfvars automatically, so a local deployment keeps working
# while the tracked terraform.tfvars stays a clean template.
*.auto.tfvars

# Real backend settings (bucket, region, profile). Backends cannot read variables,
# so these are supplied at init time with -backend-config=backend.hcl.
# The tracked backend.hcl.example shows the format.
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform output files (contain resource IDs)
output.txt

# ─── OS / IDE ─────────────────────────────────────────────────────────────────

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# VS Code
.vscode/

# JetBrains
.idea/

# Kiro
.kiro/
